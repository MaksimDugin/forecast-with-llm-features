{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Papers: Create local config",
      "type": "process",
      "command": "python",
      "args": [
        "${workspaceFolder}/reproductions/containers/deploy.py",
        "init-config",
        "--profile",
        "${input:paperProfile}"
      ],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "PYTHONDONTWRITEBYTECODE": "1",
          "PYTHONUNBUFFERED": "1"
        }
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": false
      },
      "runOptions": {
        "instanceLimit": 1
      }
    },
    {
      "label": "Papers: Deploy plan",
      "type": "process",
      "command": "python",
      "args": [
        "${workspaceFolder}/reproductions/containers/deploy.py",
